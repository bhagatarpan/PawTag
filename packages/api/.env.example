# Database
DB_URL=mongodb+srv://...

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CUSTOMER_URL=http://localhost:3002
FINDER_URL=http://localhost:3003

# CORS (comma-separated allowed origins; defaults to localhost:3000-3003 in dev, required in production)
ALLOWED_ORIGINS=

# Seed credentials (required in production, random fallback in dev if unset)
BOOTSTRAP_ADMIN_EMAIL=admin@pawtag.co.nz
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TEST_EMAIL=john@example.com
BOOTSTRAP_TEST_PASSWORD=

# Stripe (demo mode if not set)
STRIPE_SECRET_KEY=sk_test_demo_key

# SMTP / Email (demo mode if not set)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Admin notifications
ADMIN_ALERT_EMAIL=

# SMS Provider (demo|twilio)
SMS_PROVIDER=demo

# Shipping Provider (requires sandbox API key for live testing)
# Get a sandbox key from Sendle (https://www.sendle.com/developer) or NZ Post
SHIPPING_PROVIDER_API_KEY=demo_key

# Cloudflare R2 Object Storage (file uploads - falls back to local disk if not set)
# Required for production deployments where local disk is ephemeral
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Twilio (only needed if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Verification Settings (optional, defaults shown)
OTP_EXPIRY_MINUTES=10
EMAIL_TOKEN_EXPIRY_HOURS=24
MAX_OTP_ATTEMPTS=5
MAX_RESEND_COUNT=3
RESEND_COOLDOWN_SECONDS=60

# Server
PORT=5000
NODE_ENV=development
