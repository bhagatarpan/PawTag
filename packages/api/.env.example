# ═══════════════════════════════════════════════════════════════════════════════
# PawTag Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file documents all environment variables used by the PawTag API.
# Copy to .env and fill in values before starting the server.
#
# Categories:
#   [REQUIRED]    - Must be set in production or server refuses to start
#   [FEATURE]     - Required when the feature is enabled
#   [OPTIONAL]    - Safe defaults exist; override only if needed
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core (Required in Production) ──────────────────────────────────────────

# [REQUIRED] MongoDB connection string
# Example: mongodb+srv://user:pass@cluster.mongodb.net/pawtag
DB_URL=mongodb://localhost:27017/pawtag

# [REQUIRED] JWT signing secret (use a strong random string in production)
JWT_SECRET=your_jwt_secret_here

# [REQUIRED] Comma-separated allowed CORS origins
# Example: https://app.pawtag.co.nz,https://admin.pawtag.co.nz
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# [REQUIRED] Customer-facing URL (used in emails, links, etc.)
FRONTEND_URL=http://localhost:3000

# ─── Server ─────────────────────────────────────────────────────────────────

# [OPTIONAL] API port (default: 5000)
PORT=5000

# [OPTIONAL] Runtime mode (default: development)
# Options: development, production, test
NODE_ENV=development

# [OPTIONAL] Log level (default: info)
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ─── Authentication ─────────────────────────────────────────────────────────

# [OPTIONAL] Access token lifetime (default: 30m)
JWT_ACCESS_EXPIRES_IN=30m

# [OPTIONAL] Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# [OPTIONAL] Refresh token cookie name (default: pawtag_refresh_token)
REFRESH_TOKEN_COOKIE_NAME=pawtag_refresh_token

# ─── Bootstrap Accounts ─────────────────────────────────────────────────────

# [OPTIONAL] Initial admin email (created on first run)
BOOTSTRAP_ADMIN_EMAIL=admin@pawtag.co.nz

# [OPTIONAL] Initial admin password (required in production if email is set)
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Frontend URLs ──────────────────────────────────────────────────────────

# [OPTIONAL] Admin portal URL (for links in emails)
ADMIN_URL=http://localhost:3001

# [OPTIONAL] Finder portal URL (for links in emails)
FINDER_URL=http://localhost:3003

# ─── Payments (Required in Production) ──────────────────────────────────────

# [REQUIRED in prod] Stripe secret API key
# Must start with sk_live_ in production
STRIPE_SECRET_KEY=sk_test_demo_key

# [REQUIRED in prod] Stripe webhook signing secret
# Must be the actual secret, not a placeholder
STRIPE_WEBHOOK_SECRET=

# ─── Email (Feature-Required) ───────────────────────────────────────────────

# [FEATURE] SMTP host for transactional emails
SMTP_HOST=localhost

# [FEATURE] SMTP port
SMTP_PORT=587

# [FEATURE] SMTP TLS (true/false)
SMTP_SECURE=false

# [FEATURE] SMTP username
SMTP_USER=

# [FEATURE] SMTP password
SMTP_PASS=

# [FEATURE] Resend API key (alternative to SMTP)
RESEND_API_KEY=

# [OPTIONAL] Admin alert email for critical notifications
ADMIN_ALERT_EMAIL=

# ─── SMS (Feature-Required) ─────────────────────────────────────────────────

# [FEATURE] SMS provider (demo|twilio)
SMS_PROVIDER=demo

# [FEATURE] Twilio account SID (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=

# [FEATURE] Twilio auth token (required when SMS_PROVIDER=twilio)
TWILIO_AUTH_TOKEN=

# [FEATURE] Twilio from number (required when SMS_PROVIDER=twilio)
TWILIO_FROM_NUMBER=

# ─── File Storage (Feature-Required) ────────────────────────────────────────

# [FEATURE] Storage driver (local|r2)
# "local" = local filesystem (development)
# "r2" = Cloudflare R2 (production)
STORAGE_DRIVER=local

# [FEATURE] Local uploads directory (when STORAGE_DRIVER=local)
LOCAL_UPLOADS_DIR=./uploads

# [FEATURE] R2 access key (required when STORAGE_DRIVER=r2)
R2_ACCESS_KEY_ID=

# [FEATURE] R2 secret key (required when STORAGE_DRIVER=r2)
R2_SECRET_ACCESS_KEY=

# [FEATURE] R2 bucket name (required when STORAGE_DRIVER=r2)
R2_BUCKET_NAME=

# [FEATURE] R2 endpoint URL (required when STORAGE_DRIVER=r2)
R2_ENDPOINT=

# [FEATURE] R2 public URL for serving files
R2_PUBLIC_URL=

# ─── Push Notifications (Feature-Required) ──────────────────────────────────

# [FEATURE] Firebase project ID (required for push notifications)
FIREBASE_PROJECT_ID=

# [FEATURE] Firebase client email
FIREBASE_CLIENT_EMAIL=

# [FEATURE] Firebase private key
FIREBASE_PRIVATE_KEY=

# ─── Shipping ───────────────────────────────────────────────────────────────

# [OPTIONAL] Shipping provider API key
SHIPPING_PROVIDER_API_KEY=demo_key

# [OPTIONAL] NZ Post client ID
COMMERCE_SHIPPING_NZPOST_CLIENT_ID=

# ─── Monitoring (Feature-Required) ──────────────────────────────────────────

# [FEATURE] Sentry DSN for error tracking
SENTRY_DSN=

# [OPTIONAL] Sentry sample rate (default: 1.0)
SENTRY_SAMPLE_RATE=

# [OPTIONAL] Sentry traces sample rate (default: 0.1)
SENTRY_TRACES_SAMPLE_RATE=

# [OPTIONAL] OpenTelemetry exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# [OPTIONAL] OpenTelemetry sample rate
OTEL_SAMPLE_RATE=

# [OPTIONAL] OpenTelemetry console exporter (true/false)
OTEL_CONSOLE_EXPORTER=

# ─── Service Identity ───────────────────────────────────────────────────────

# [OPTIONAL] Service name for logging/tracing
SERVICE_NAME=pawtag-api

# [OPTIONAL] Service version for logging/tracing
SERVICE_VERSION=0.1.0

# ─── Rate Limiting ──────────────────────────────────────────────────────────

# [OPTIONAL] General rate limit (requests per window)
RATE_LIMIT_MAX=1000

# [OPTIONAL] Auth rate limit
AUTH_RATE_LIMIT_MAX=20

# [OPTIONAL] Login rate limit
LOGIN_RATE_LIMIT_MAX=5

# [OPTIONAL] Registration rate limit
REGISTER_RATE_LIMIT_MAX=3

# [OPTIONAL] Forgot password rate limit
FORGOT_PASSWORD_RATE_LIMIT_MAX=3

# [OPTIONAL] Support contact rate limit
SUPPORT_RATE_LIMIT_MAX=10

# ─── Verification ───────────────────────────────────────────────────────────

# [OPTIONAL] OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# [OPTIONAL] Email token expiry in hours
EMAIL_TOKEN_EXPIRY_HOURS=24

# [OPTIONAL] Max OTP attempts before lockout
MAX_OTP_ATTEMPTS=5

# [OPTIONAL] Max resend count
MAX_RESEND_COUNT=3

# [OPTIONAL] Resend cooldown in seconds
RESEND_COOLDOWN_SECONDS=60

# ─── Worker ─────────────────────────────────────────────────────────────────

# [OPTIONAL] Worker role (api|worker)
# Set to "worker" to run as dedicated job worker
PAWTAG_WORKER_ROLE=api
