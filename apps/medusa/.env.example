# MedusaJS Configuration
# Replace with your own Neon PostgreSQL connection string
MEDUSA_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/pawtag_medusa?sslmode=require
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_DASHBOARD_URL=http://localhost:9000/app

# MongoDB (for product migration seed — reads from PawTag MongoDB)
MONGODB_URI=your_mongodb_connection_string_here

# CORS
ADMIN_CORS=http://localhost:9000,http://localhost:3001
STORE_CORS=http://localhost:3000,http://localhost:3001

# Stripe (add your keys)
STRIPE_API_KEY=

# Admin credentials
MEDUSA_ADMIN_EMAIL=admin@pawtag.co.nz
MEDUSA_ADMIN_PASSWORD=your_password_here
